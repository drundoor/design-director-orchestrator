{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drundoor/design-director-orchestrator/blob/main/scripts/render.config.schema.json",
  "title": "Design Director Render Config",
  "type": "object",
  "required": ["url"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "url": { "type": "string", "minLength": 1 },
    "platform": {
      "enum": ["web", "native-ios", "native-android", "game-canvas", "data-viz", "unknown"]
    },
    "surface": { "type": "string" },
    "qaProfile": {
      "enum": ["audit", "repair", "revamp", "implementation", "final-qa", "static"]
    },
    "waitForSelector": { "type": "string", "minLength": 1 },
    "waitMs": { "type": "number", "minimum": 0 },
    "fullPage": { "type": "boolean" },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/viewport" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": true,
      "properties": {
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 }
      }
    },
    "state": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "waitForSelector": { "type": "string", "minLength": 1 },
        "waitMs": { "type": "number", "minimum": 0 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "discoveredFrom": { "type": "object" }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "click",
            "fill",
            "type",
            "focus",
            "blur",
            "hover",
            "press",
            "keyboardShortcut",
            "select",
            "check",
            "uncheck",
            "wait",
            "waitForSelector",
            "waitForNetworkIdle",
            "waitForStableLayout",
            "reload",
            "scrollIntoView",
            "scrollBy",
            "scrollTo",
            "wheel",
            "drag",
            "resizeViewport",
            "setViewport",
            "setLocalStorage",
            "setSessionStorage",
            "clearStorage",
            "assertVisible",
            "assertHidden",
            "assertText",
            "assertNoHorizontalOverflow",
            "screenshotElement",
            "scrollBoundaryCheck"
          ]
        },
        "selector": { "type": "string", "minLength": 1 },
        "value": {},
        "text": { "type": "string" },
        "key": { "type": "string", "minLength": 1 },
        "ms": { "type": "number", "minimum": 0 },
        "waitMs": { "type": "number", "minimum": 0 },
        "timeout": { "type": "number", "minimum": 0 },
        "state": { "enum": ["attached", "detached", "visible", "hidden"] },
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "deltaX": { "type": "number" },
        "deltaY": { "type": "number" },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" },
        "startX": { "type": "number" },
        "startY": { "type": "number" },
        "endX": { "type": "number" },
        "endY": { "type": "number" }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["click", "focus", "blur", "hover", "check", "uncheck", "scrollIntoView", "assertVisible", "assertHidden", "screenshotElement", "scrollBoundaryCheck"] } }
          },
          "then": { "required": ["selector"] }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["fill", "type", "select"] } }
          },
          "then": { "required": ["selector", "value"] }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "wait" } }
          },
          "then": { "anyOf": [{ "required": ["ms"] }, { "required": ["waitMs"] }] }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "waitForSelector" } }
          },
          "then": { "required": ["selector"] }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["press", "keyboardShortcut"] } }
          },
          "then": { "anyOf": [{ "required": ["key"] }, { "required": ["value"] }] }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["resizeViewport", "setViewport"] } }
          },
          "then": { "required": ["width", "height"] }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["setLocalStorage", "setSessionStorage"] } }
          },
          "then": { "required": ["key", "value"] }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "assertText" } }
          },
          "then": {
            "required": ["selector"],
            "anyOf": [{ "required": ["value"] }, { "required": ["text"] }]
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["scrollBy", "scrollTo", "wheel"] } }
          },
          "then": {
            "anyOf": [
              { "required": ["x"] },
              { "required": ["y"] },
              { "required": ["deltaX"] },
              { "required": ["deltaY"] }
            ]
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "drag" } }
          },
          "then": {
            "anyOf": [
              { "required": ["from", "to"] },
              { "required": ["startX", "startY", "endX", "endY"] }
            ]
          }
        }
      ]
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": true,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "waiver": {
      "type": "object",
      "required": ["check", "reason", "evidence", "owner", "expires"],
      "additionalProperties": true,
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
      }
    }
  }
}
