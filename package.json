{
  "name": "design-director-orchestrator",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Codex Design Director skill for UI design orchestration, source-of-truth routing, interactive rendered QA, and visual consistency audits.",
  "license": "MIT",
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PROVENANCE.md",
    "REFERENCED_SKILLS.md",
    "REFERENCE_LICENSE_POLICY.md",
    "agents/",
    "examples/",
    "fixtures/",
    "references/",
    "schemas/",
    "scripts/",
    "test/"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test",
    "discover": "node scripts/discover-states.mjs",
    "render-check": "node scripts/render-check.mjs",
    "dom-audit": "node scripts/dom-audit.mjs",
    "visual-audit": "node scripts/visual-consistency-audit.mjs",
    "qa-report": "node scripts/qa-report.mjs",
    "qa:web": "node scripts/run-web-qa.mjs",
    "qa:web:draft": "node scripts/run-web-qa.mjs --draft",
    "qa:web:ci": "node scripts/run-web-qa.mjs --ci",
    "qa:web:final": "node scripts/run-web-qa.mjs --final",
    "qa:native:ios": "node scripts/run-native-qa.mjs --platform native-ios",
    "qa:native:android": "node scripts/run-native-qa.mjs --platform native-android",
    "native-qa-report": "node scripts/native-qa-report.mjs",
    "mockup:init": "node scripts/init-mockup.mjs",
    "mockup:assert": "node scripts/assert-output-root.mjs",
    "peer:check": "node scripts/check-peer-skills.mjs",
    "peer:validate": "node scripts/validate-peer-evidence.mjs",
    "source:caveat": "node scripts/source-caveat-audit.mjs",
    "brief:new": "node scripts/init-brief.mjs",
    "research:ledger": "node scripts/init-research-ledger.mjs",
    "reference:seed": "node scripts/seed-reference-ledger.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "smoke:native:fail": "node scripts/smoke-native-fail.mjs",
    "install:codex": "node scripts/install-local.mjs",
    "install:codex:bundle": "node scripts/install-bundle.mjs"
  },
  "devDependencies": {
    "playwright": "^1.45.0"
  }
}
