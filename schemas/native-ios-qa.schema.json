{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drundoor/design-director-orchestrator/blob/main/schemas/native-ios-qa.schema.json",
  "title": "Design Director Native iOS QA Report",
  "type": "object",
  "required": ["platform", "target", "tooling", "matrix", "checks", "logs"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "platform": { "const": "native-ios" },
    "target": {
      "type": "object",
      "required": ["scheme", "simulator"],
      "additionalProperties": true,
      "properties": {
        "project": { "type": "string" },
        "workspace": { "type": "string" },
        "scheme": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string" },
        "simulator": { "type": "string", "minLength": 1 },
        "device": { "type": "string" },
        "osVersion": { "type": "string" }
      },
      "anyOf": [{ "required": ["project"] }, { "required": ["workspace"] }]
    },
    "tooling": {
      "type": "object",
      "required": ["commandsOrToolCalls"],
      "additionalProperties": true,
      "properties": {
        "preferred": { "type": "string" },
        "fallback": { "type": "string" },
        "commandsOrToolCalls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "appearance", "contentSize", "orientation", "screenshot", "uiHierarchy", "result"],
        "additionalProperties": true,
        "properties": {
          "state": { "type": "string", "minLength": 1 },
          "profile": { "type": "string" },
          "profiles": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "appearance": { "enum": ["light", "dark", "both"] },
          "contentSize": { "type": "string", "minLength": 1 },
          "orientation": { "type": "string", "minLength": 1 },
          "keyboard": { "type": "boolean" },
          "focusedEditable": { "type": "boolean" },
          "screenshot": { "type": "string", "minLength": 1 },
          "uiHierarchy": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "needs-review", "fail", "blocked"] }
        }
      }
    },
    "checks": { "type": "object" },
    "notApplicableProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["reason", "evidence"],
        "additionalProperties": true,
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "logs": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "blockers": { "type": "array" },
    "warnings": { "type": "array" }
  }
}
