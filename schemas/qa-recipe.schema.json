{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drundoor/design-director-orchestrator/blob/main/schemas/qa-recipe.schema.json",
  "title": "Design Director QA Recipe",
  "type": "object",
  "required": ["name", "states"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "surface": { "type": "string" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "actions"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": true,
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "selector": { "type": "string" },
                "optional": { "type": "boolean" },
                "focusedEvidenceKind": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
