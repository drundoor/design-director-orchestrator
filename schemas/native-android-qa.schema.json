{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drundoor/design-director-orchestrator/blob/main/schemas/native-android-qa.schema.json",
  "title": "Design Director Native Android QA Report",
  "type": "object",
  "required": ["platform", "target", "tooling", "matrix", "checks", "logs"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "platform": { "const": "native-android" },
    "target": {
      "type": "object",
      "required": ["module", "variant", "device", "apiLevel"],
      "additionalProperties": true,
      "properties": {
        "module": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "apiLevel": {},
        "density": { "type": "string" },
        "fontScale": { "type": "number" }
      }
    },
    "tooling": {
      "type": "object",
      "required": ["commandsOrToolCalls"],
      "additionalProperties": true,
      "properties": {
        "preferred": { "type": "string" },
        "fallback": { "type": "string" },
        "commandsOrToolCalls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "theme", "fontScale", "displaySize", "screenshot", "uiTree", "result"],
        "additionalProperties": true,
        "properties": {
          "state": { "type": "string", "minLength": 1 },
          "theme": { "enum": ["light", "dark", "both"] },
          "fontScale": { "type": "number" },
          "displaySize": { "type": "string", "minLength": 1 },
          "screenshot": { "type": "string", "minLength": 1 },
          "uiTree": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "needs-review", "fail", "blocked"] }
        }
      }
    },
    "checks": { "type": "object" },
    "logs": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "blockers": { "type": "array" },
    "warnings": { "type": "array" },
    "waivers": { "type": "array" }
  }
}
