{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drundoor/design-director-orchestrator/blob/main/schemas/render-config.schema.json",
  "title": "Design Director Render Config",
  "type": "object",
  "required": ["url"],
  "additionalProperties": true,
  "properties": {
    "url": { "type": "string", "minLength": 1 },
    "platform": {
      "enum": ["web", "native-ios", "native-android", "game-canvas", "data-viz", "unknown"]
    },
    "surface": { "type": "string" },
    "qaProfile": {
      "enum": ["audit", "repair", "revamp", "implementation", "final-qa", "static", "draft-static-mockup"]
    },
    "qaRunId": { "type": "string", "minLength": 1 },
    "viewportPreset": { "enum": ["default", "mockup", "mobile-tablet-desktop"] },
    "recipes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "focus": {
      "type": "array",
      "items": { "$ref": "#/$defs/focusTarget" }
    },
    "dataCaveat": { "$ref": "#/$defs/dataCaveat" },
    "singlePassDraftRequested": { "type": "boolean" },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/viewport" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "states": {
      "type": "array",
      "items": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 }
      }
    },
    "state": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "selector": { "type": "string" },
        "value": {},
        "optional": { "type": "boolean" },
        "focusedEvidenceKind": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "focusTarget": {
      "type": "object",
      "required": ["selector", "kind"],
      "additionalProperties": true,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "dataCaveat": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "truthStatus": { "type": "string" },
        "sourceLabel": { "type": "string" },
        "requiredInBrief": { "type": "boolean" },
        "requiredInQa": { "type": "boolean" },
        "uiPolicy": { "type": "string" },
        "prominentUiBannerAllowed": { "type": "boolean" },
        "stakeholderFacing": { "type": "boolean" }
      }
    }
  }
}
