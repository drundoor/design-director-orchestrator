{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drundoor/design-director-orchestrator/blob/main/schemas/peer-execution.schema.json",
  "title": "Design Director Peer Skill Execution Evidence",
  "type": "object",
  "required": ["status"],
  "additionalProperties": true,
  "properties": {
    "status": {
      "enum": ["available", "unavailable-fallback-used", "user-waived", "skipped-while-available"]
    },
    "executionEvidence": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fallbackChecklistCompleted": { "type": "boolean" },
    "fallbackEvidence": {
      "type": "object",
      "required": ["path", "requiredChecks"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reason": { "type": "string" },
    "waiverEvidence": { "type": "string" }
  }
}
